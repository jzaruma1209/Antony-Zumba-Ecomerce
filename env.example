# ============================
# BASE DE DATOS
# ============================
# Local con Docker: postgresql://postgres:postgres@localhost:5432/basictechshop
DATABASE_URL="postgresql://usuario:password@localhost:5432/basictechshop"

# ============================
# STRIPE (pagos)
# Dashboard: https://dashboard.stripe.com/test/apikeys
# ============================
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ============================
# CLOUDINARY (imagenes)
# Dashboard: https://console.cloudinary.com/
# ============================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================
# NEXTAUTH (autenticacion)
# Generar secret: openssl rand -base64 32
# ============================
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ============================
# APP URL
# ============================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
